# Supabase Configuration (anon key is public by design)
VITE_SUPABASE_URL=https://wthnnwnggvvktrnglxqj.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile site key (public). Leave blank to disable the signup
